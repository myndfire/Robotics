# LLM provider (see https://github.com/myndfire/pydanticai-fluent/blob/master/USAGE.md#supported-providers)
# vLLM exposes an OpenAI-compatible API, so use provider=openai with its base URL.
CAMERA_AGENT_PROVIDER=openai
CAMERA_AGENT_MODEL=Qwen3-VL-4B-Instruct-4bit
CAMERA_AGENT_BASE_URL=http://localhost:8000/v1
# vLLM accepts any non-empty key when started without --api-key.
CAMERA_AGENT_API_KEY=EMPTY

# Vision model used by the describe_picture tool. Must accept image input.
# Qwen3-VL is multimodal, so the same model serves both roles.
CAMERA_AGENT_VISION_MODEL=Qwen3-VL-4B-Instruct-4bit

# Main model temperature. 0 = deterministic tool calls (recommended).
CAMERA_AGENT_TEMPERATURE=0

# BLE device name to scan for
CAMERA_AGENT_DEVICE=ApiBLE

# Fast-moving-object capture defaults (applied on every take_picture).
# Lower shutter = shorter exposure = less motion blur but darker; raise gain
# to compensate (brighter but noisier). ble_mtu + chunk_delay_ms speed up the
# JPEG-over-BLE transfer. All are optional overrides of the code defaults.
# CAMERA_AGENT_AEC=off
# CAMERA_AGENT_SHUTTER=300
# CAMERA_AGENT_GAIN=20
# CAMERA_AGENT_BLE_MTU=517
# CAMERA_AGENT_CHUNK_DELAY_MS=2

# Debug mode — prints every LLM tool-call decision and tool execution trace.
# Set to 1 (or true/yes) to enable. Default: 0.
CAMERA_AGENT_DEBUG=0

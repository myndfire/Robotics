# LLM provider (see https://github.com/myndfire/pydanticai-fluent/blob/master/USAGE.md#supported-providers)
CAMERA_AGENT_PROVIDER=ollama
CAMERA_AGENT_MODEL=gpt-oss:20b

# Vision model used by the describe_picture tool. Must be a model that accepts
# image input and must be served by Ollama (e.g. llava, llava-phi3).
CAMERA_AGENT_VISION_MODEL=llava

# Main model temperature. 0 = deterministic tool calls (recommended for
# gpt-oss:20b, whose default of 1 intermittently emits tool-call JSON as text).
CAMERA_AGENT_TEMPERATURE=0

# BLE device name to scan for
CAMERA_AGENT_DEVICE=ApiBLE

# Debug mode — prints every LLM tool-call decision and tool execution trace.
# Set to 1 (or true/yes) to enable. Default: 0.
CAMERA_AGENT_DEBUG=0
